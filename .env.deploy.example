# Copier en « .env » sur le VPS puis remplir. NE PAS committer le vrai .env.
# Domaine (doit pointer vers l'IP du VPS en DNS)
DOMAIN=commandes.sheleg.fr

# Connexion Odoo
ODOO_URL=https://sheleg.odoo.com
ODOO_DB=sheleg
ODOO_USERNAME=ymelloul@maayane.fr
ODOO_API_KEY=

# Secret de session (générer : openssl rand -hex 32)
JWT_SECRET=

# Optionnels
DEFAULT_VAT_RATE=5.5
ODOO_COMMERCIAL_FIELD=x_studio_commercial
