# --- Serveur ---
PORT=3001
# Secret pour signer les jetons de session (changez-le en production)
JWT_SECRET=change-me-in-production

# --- Connexion Odoo (Odoo Online) ---
# Laisser vide pour utiliser le MODE DÉMO (données fictives, sans Odoo).
# URL de votre instance, sans slash final. Ex : https://sheleg.odoo.com
ODOO_URL=
# Nom de la base de données Odoo
ODOO_DB=
# Email / login de l'utilisateur Odoo utilisé pour l'API
ODOO_USERNAME=
# Clé API générée dans Odoo (Préférences > Sécurité du compte > Clés API)
ODOO_API_KEY=

# --- Authentification de l'application (commerciaux) ---
# En mode démo, identifiants de connexion à l'app :
DEMO_USER=sheleg
DEMO_PASSWORD=sheleg
